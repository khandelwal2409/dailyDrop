# Local development: copy this file to .env. SQLite is created automatically.
PORT=3000
NODE_ENV=development
DB_PATH=data/dailydrop.sqlite
ALLOW_REGISTRATION=true
SELLER_USERNAMES=household-seller
TRUST_PROXY_HOPS=0
SQLITE_MIGRATION_PATH=

# Optional source path when running `npm run migrate:sqlite` manually.
# SQLITE_PATH=data/dailydrop.sqlite

# Production values belong in Render's web service environment settings,
# not in a committed .env file. Render supplies PORT and DATABASE_URL.
# Render's NODE_VERSION is configured in render.yaml.
# NODE_ENV=production
# DB_PATH is not used in production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# ALLOW_REGISTRATION=true
# SELLER_USERNAMES=your-seller-username
# TRUST_PROXY_HOPS=1
# SQLITE_MIGRATION_PATH=/var/data/dailydrop.sqlite