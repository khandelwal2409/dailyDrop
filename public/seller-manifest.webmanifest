{
  "id": "/seller",
  "name": "DailyDrop Seller",
  "short_name": "DailyDrop Seller",
  "description": "DailyDrop user subscriptions and monthly payment operations.",
  "start_url": "/seller",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#fff4f3",
  "theme_color": "#a51f2b",
  "icons": [
    {
      "src": "/icons/seller-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/seller-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
